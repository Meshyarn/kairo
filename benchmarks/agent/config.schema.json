{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent Benchmark Suite",
  "type": "object",
  "required": ["suite_id", "version", "model", "cases"],
  "properties": {
    "suite_id": { "type": "string" },
    "version": { "type": "string" },
    "mode": { "type": "string", "enum": ["mock", "replay", "live"] },
    "tool_mode": { "type": "string", "enum": ["baseline", "kairo"] },
    "attempts": { "type": "integer", "minimum": 1 },
    "timeout_ms": { "type": "integer", "minimum": 1000 },
    "output_dir": { "type": "string" },
    "pricing": {
      "type": "object",
      "properties": {
        "snapshot": { "type": "string" },
        "currency": { "type": "string" },
        "input_per_1k": { "type": "number", "minimum": 0 },
        "cached_input_per_1k": { "type": "number", "minimum": 0 },
        "output_per_1k": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": ["provider", "id"],
      "properties": {
        "provider": { "type": "string" },
        "id": { "type": "string" },
        "params": { "type": "object" }
      },
      "additionalProperties": true
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "category", "description", "fixture", "prompt", "validators"],
        "properties": {
          "id": { "type": "string" },
          "category": { "type": "string" },
          "description": { "type": "string" },
          "fixture": {
            "oneOf": [
              { "type": "string" },
              {
                "type": "object",
                "required": ["type"],
                "properties": {
                  "type": { "type": "string", "const": "git" },
                  "ref": { "type": "string" },
                  "paths": { "type": "array", "items": { "type": "string" } }
                },
                "additionalProperties": false
              },
              {
                "type": "object",
                "required": ["type", "paths"],
                "properties": {
                  "type": { "type": "string", "const": "worktree" },
                  "paths": { "type": "array", "minItems": 1, "items": { "type": "string" } }
                },
                "additionalProperties": false
              }
            ]
          },
          "prompt": { "type": "string" },
          "attempts": { "type": "integer", "minimum": 1 },
          "timeout_ms": { "type": "integer", "minimum": 1000 },
          "validators": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/validator" }
          },
          "mock_output": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "validator": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string" },
        "source": { "type": "string" },
        "expect": {},
        "allow_empty": { "type": "boolean" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["path"],
            "properties": {
              "path": { "type": "string" },
              "expect_text": { "type": "string" },
              "expect_texts": { "type": "array", "items": { "type": "string" } },
              "contains_text": { "type": "string" },
              "contains_texts": { "type": "array", "items": { "type": "string" } },
              "excludes_text": { "type": "string" },
              "excludes_texts": { "type": "array", "items": { "type": "string" } },
              "expect_sha256": { "type": "string" },
              "expect_json": {}
            },
            "additionalProperties": false
          }
        },
        "command": { "type": "string" },
        "stdout_contains": { "type": "string" },
        "stderr_contains": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
