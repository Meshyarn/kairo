{
  "name": "kairo",
  "version": "0.4.17",
  "type": "module",
  "bin": {
    "kairo": "dist/index.js",
    "kairo-gen-languages": "dist/cli/generate-languages-config.js",
    "kairo-build-markdown-wasm": "dist/cli/build-markdown-wasm.js",
    "kairo-warmup-embeddings": "dist/cli/warmup-embeddings.js",
    "kairo-build-vector-index": "dist/cli/build-vector-index.js",
    "kairo-migrate-embeddings-pack": "dist/cli/migrate-embeddings-pack.js"
  },
  "files": [
    "dist",
    "node_modules/tree-sitter-wasms",
    "LICENSE",
    "README.md"
  ],
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "migrate:mcp-config": "node --import tsx scripts/migrate-mcp-config.ts",
    "bundle:models": "node scripts/bundle-models.mjs",
    "pretest": "npm run build",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=8196\" jest dist --runInBand",
    "test:detect-open-handles": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=8196\" jest dist --runInBand --detectOpenHandles",
    "test:perf": "npm run build && KAIRO_INCLUDE_PERF=true NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=8196\" jest dist --runInBand --testPathPattern=performance",
    "benchmark:lod-comp": "tsx benchmarks/lod-comparison.ts",
    "benchmark:lod-promo": "tsx benchmarks/lod-promotion-flow.ts",
    "test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=8196\" jest dist --coverage",
    "test:coverage:orchestration": "NODE_OPTIONS=\"--experimental-vm-modules --max-old-space-size=8196\" jest dist --runInBand --coverage --collectCoverageFrom=\"dist/orchestration/**/*.js\" --coveragePathIgnorePatterns=\"/dist/tests/\"",
    "test:markdown-wasm-cli": "node scripts/test-markdown-wasm-cli.mjs",
    "build": "node scripts/clean-dist.mjs && tsc && mkdir -p dist/queries dist/tests/languages/fixtures && cp -r src/queries/* dist/queries/ && cp -r src/tests/languages/fixtures/* dist/tests/languages/fixtures/",
    "build:core-rs": "npm --prefix crates/core-rs run build",
    "build:markdown-wasm": "node dist/cli/build-markdown-wasm.js",
    "validate:languages": "node --import tsx scripts/validate-language-support.ts",
    "validate:parity": "node --import tsx scripts/validate-parity.ts",
    "start": "tsx src/index.ts",
    "prepack": "npm run build && npm run bundle:models"
  },
  "keywords": [
    "modelcontextprotocol",
    "mcp",
    "context",
    "vibe-coding",
    "developer tools",
    "ai-assisted coding",
    "kairo",
    "editor",
    "file analysis"
  ],
  "author": "devkwan",
  "license": "MIT",
  "description": "A Model Context Protocol (MCP) enabled tool for AI-assisted coding and intelligent file analysis.",
  "devDependencies": {
    "@types/babel__parser": "^7.0.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/debounce": "^1.2.4",
    "@types/fast-levenshtein": "^0.0.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.16",
    "@types/resolve": "^1.20.6",
    "jest": "^29.7.0",
    "jscpd": "^4.0.5"
  },
  "dependencies": {
    "@babel/parser": "^7.28.5",
    "@babel/traverse": "^7.28.5",
    "@babel/types": "^7.28.5",
    "@google/generative-ai": "^0.2.1",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "@xenova/transformers": "^2.8.0",
    "chokidar": "^3.5.3",
    "fast-levenshtein": "^2.0.6",
    "hnswlib-wasm": "^0.8.0",
    "ignore": "^5.2.0",
    "lru-cache": "^10.2.0",
    "mammoth": "^1.4.24",
    "mdast-util-to-string": "^3.2.0",
    "pdfjs-dist": "^4.4.168",
    "remark-mdx": "^3.0.1",
    "remark-parse": "^11.0.0",
    "resolve": "^1.22.11",
    "tree-sitter-wasms": "^0.1.13",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "web-tree-sitter": "^0.25.10",
    "xlsx": "^0.18.5",
    "xxhashjs": "^0.2.2"
  },
  "optionalDependencies": {
    "@kairo/core-rs": "file:crates/core-rs"
  }
}
